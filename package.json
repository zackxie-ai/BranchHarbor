{
  "name": "branchharbor",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Collaborative control plane for isolated coding agents and Git Worktrees.",
  "license": "MIT",
  "keywords": [
    "ai-agent",
    "coding-agent",
    "collaboration",
    "git-worktree",
    "byok"
  ],
  "engines": {
    "node": ">=20 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "bash scripts/dev.sh",
    "worker": "pnpm --filter @branchharbor/control-plane worker",
    "db:migrate": "bash scripts/db-migrate.sh",
    "build": "pnpm --filter @branchharbor/control-plane build",
    "typecheck": "pnpm --filter @branchharbor/control-plane typecheck",
    "test": "pnpm --filter @branchharbor/control-plane test",
    "test:smoke": "bash scripts/full-smoke.sh",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "release:tree": "bash scripts/verify-release-tree.sh",
    "release:check": "bash scripts/release-check.sh",
    "test:acp": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/acp-smoke.ts",
    "test:openai-compatible-agent": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/openai-compatible-agent-smoke.ts",
    "test:integration-agent": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/integration-agent-smoke.ts",
    "test:http-user-flow": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/http-user-flow-smoke.ts",
    "test:integration-queue": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/integration-queue-smoke.ts",
    "test:project-validation": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/project-validation-smoke.ts",
    "test:audit-query": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/audit-query-smoke.ts",
    "test:merge-planning": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/merge-planning-smoke.ts",
    "test:merge-plan-agent": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/merge-plan-agent-smoke.ts",
    "test:credential-lifecycle": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/credential-lifecycle-smoke.ts",
    "test:credential-lease-runtime": "CREDENTIAL_LEASE_TTL_SECONDS=1 pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/credential-lease-runtime-smoke.ts",
    "test:membership-invitation": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/membership-invitation-smoke.ts",
    "test:project-membership": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/project-membership-smoke.ts",
    "test:task-cancellation": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/task-cancellation-smoke.ts",
    "test:task-coordination": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/task-coordination-smoke.ts",
    "test:task-dependency-management": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/task-dependency-management-smoke.ts",
    "test:task-progress-monitor": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/task-progress-monitor-smoke.ts",
    "test:task-preview": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/task-preview-smoke.ts",
    "test:task-workspace-progress": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/task-workspace-progress-smoke.ts",
    "test:task-workspace-durability": "pnpm --filter @branchharbor/control-plane exec tsx ../../scripts/task-workspace-durability-smoke.ts",
    "infra:up": "docker compose --env-file .env -f infra/compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/compose.yml down",
    "infra:status": "docker compose --env-file .env -f infra/compose.yml ps",
    "infra:logs": "docker compose --env-file .env -f infra/compose.yml logs -f",
    "check": "bash scripts/check.sh"
  }
}
