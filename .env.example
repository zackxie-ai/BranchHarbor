COMPOSE_PROJECT_NAME=branchharbor

# LOCAL DEVELOPMENT ONLY.
# These values are intentionally easy to replace and must never be reused for
# an internet-facing deployment. See SECURITY.md before exposing any service.

# BranchHarbor control plane
CONTROL_PLANE_PORT=3210
AUTH_COOKIE_NAME=branchharbor_session
AUTH_SESSION_TTL_SECONDS=604800
CREDENTIAL_LEASE_TTL_SECONDS=1800
AUTH_SECURE_COOKIES=false

# PostgreSQL shared development server
POSTGRES_USER=branchharbor
POSTGRES_PASSWORD=branchharbor-local-change-me
POSTGRES_PORT=5432

# Gitea
GITEA_HTTP_PORT=3100
GITEA_SSH_PORT=2222
GITEA_ADMIN_USER=branchharbor-admin
GITEA_ADMIN_PASSWORD=branchharbor-admin-change-me
GITEA_ADMIN_EMAIL=admin@branchharbor.local

# Temporal
TEMPORAL_GRPC_PORT=7233
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=branchharbor-control-plane
TEMPORAL_DISABLE_HTTP_PROXY=true

# OpenBao - local development mode only
OPENBAO_PORT=8200
OPENBAO_DEV_ROOT_TOKEN=branchharbor-local-root-token

# AIO Sandbox runner
SANDBOX_MEMORY=4g
SANDBOX_CPUS=2
SANDBOX_IMAGE=ghcr.io/agent-infra/sandbox:1.11.0
RUNNER_PREVIEW_HOST_SUFFIX=preview.localhost
TZ=Asia/Shanghai
